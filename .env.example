# Every variable the hub and the runner read. No values here, ever.
# Local: `vercel env pull .env.local` fills the Vercel ones; the rest you set by hand.

# --- Hub API (apps/hub-api)
# Postgres. Preview/Production: Neon via the Vercel Marketplace.
# Local: postgresql://jigworks:jigworks@localhost:54329/jigworks (docker compose up -d db)
DATABASE_URL=
# Vercel Blob store `jigworks-bundles` (release bundles)
BLOB_READ_WRITE_TOKEN=
# Shared hub password: web session cookie and the X-Jigworks-Key header
HUB_PASSWORD=
# Vercel Sandbox auth for validate / get_graph() (pulled by `vercel env pull`)
VERCEL_OIDC_TOKEN=

# --- Tests against a protected preview deploy (optional; otherwise use `vercel curl`)
VERCEL_AUTOMATION_BYPASS_SECRET=

# --- Runner and VS Code extension
# Hub base URL, e.g. the preview URL or http://localhost:3000
JIGWORKS_HUB_URL=
# Sent as X-Jigworks-Key; same value as HUB_PASSWORD
JIGWORKS_HUB_KEY=
# 1 = allow tests marked `live` to call the real `claude -p`
JIGWORKS_LIVE=

# --- Parallel build only (set in .claude/settings.local.json of each worktree)
# hub | local
JIGWORKS_AGENT=
