{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jigworks.dev/schema/jigworks.schema.json",
  "title": "JigworksContracts",
  "description": "Frozen contracts shared by the runner (Python), the VS Code extension and the hub (TS + Python). Source of truth; TS types, pydantic models and openapi.json are generated from this file. Field names are camelCase except the UsageRecord token fields, which keep the names from design.md §8 (input, output, cache_write, cache_read).",
  "$defs": {
    "Email": {
      "type": "string",
      "pattern": "^[^@\\s]+@[^@\\s]+$",
      "description": "From `git config user.email` on the engineer's machine; the hub trusts it (design.md §8 Access). Deliberately loose: an unconfigured git may report e.g. dev@MacBook.local."
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339, UTC, e.g. 2026-11-19T15:00:00Z."
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "sha256 of the exact bytes of the release bundle .zip, as `sha256:<hex>`."
    },
    "ReleaseRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*@[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$",
      "description": "`<workflowId>@<semver>`, e.g. feature-development@1.3.0."
    },
    "WorkflowId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Slug of a workflow package, e.g. feature-development."
    },
    "RunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Generated by the runner (so events can be queued before the hub knows the run), e.g. run_123 or run_01JD…"
    },
    "NodeId": {
      "type": "string",
      "minLength": 1,
      "description": "LangGraph node name, e.g. plan, write_tests, implement, review, fix, gate, approve_pr, open_pr."
    },
    "Adapter": {
      "type": "string",
      "enum": ["claude", "codex", "fake"],
      "description": "CLI agent adapter. `fake` is the deterministic test adapter."
    },
    "NodeStatus": {
      "type": "string",
      "enum": ["pending", "running", "waiting_human", "succeeded", "failed", "skipped", "cancelled"]
    },
    "RunStatus": {
      "type": "string",
      "enum": ["running", "waiting_human", "paused_usage_limit", "succeeded", "failed", "rejected", "cancelled"],
      "description": "waiting_human = an interrupt is open (the extension shows a Review badge instead of %). paused_usage_limit = the subscription limit was hit; resumable."
    },
    "EventKind": {
      "type": "string",
      "enum": [
        "run_started",
        "node_status",
        "interrupt",
        "review_decision",
        "agent_output",
        "gate_result",
        "usage",
        "usage_limit",
        "error",
        "run_finished"
      ]
    },
    "InterruptStage": {
      "type": "string",
      "enum": ["plan", "pr"],
      "description": "plan = approve the plan; pr = human review before the PR is opened."
    },
    "ReviewDecisionValue": {
      "type": "string",
      "enum": ["approve", "request_changes", "reject"]
    },
    "HumanDeltaOutcome": {
      "type": "string",
      "enum": ["worked_first_time", "corrected_by_prompt", "edited_by_hand", "rejected"]
    },
    "TokenType": {
      "type": "string",
      "enum": ["input", "output", "cache_write", "cache_read"]
    },
    "ChannelName": {
      "type": "string",
      "enum": ["stable", "beta"]
    },
    "ModelAssignment": {
      "type": "object",
      "description": "Models are set by the workflow release (`[models]` in workflow.toml), never picked in VS Code.",
      "additionalProperties": false,
      "required": ["default"],
      "properties": {
        "default": { "type": "string", "minLength": 1, "description": "Model id or CLI alias used by every node without an override." },
        "nodes": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 },
          "description": "Per-node override: node name → model."
        }
      }
    },
    "UsageRecord": {
      "type": "object",
      "description": "Raw tokens of one agent call for one model (design.md §8). Claude adapter: one record per key of result.modelUsage of the final stream-json `result` event (docs/spikes/claude-stream-json.md §8). Cost is computed at read time from PriceEntry; cliCostUsd is a cross-check only.",
      "additionalProperties": false,
      "required": ["runId", "node", "attempt", "model", "adapter", "input", "output", "cache_write", "cache_read"],
      "properties": {
        "runId": { "$ref": "#/$defs/RunId" },
        "node": { "$ref": "#/$defs/NodeId" },
        "attempt": { "type": "integer", "minimum": 1 },
        "model": { "type": "string", "minLength": 1, "description": "Resolved model id as reported by the CLI (modelUsage key), e.g. claude-sonnet-5." },
        "adapter": { "$ref": "#/$defs/Adapter" },
        "input": { "type": "integer", "minimum": 0, "description": "claude: modelUsage[m].inputTokens" },
        "output": { "type": "integer", "minimum": 0, "description": "claude: modelUsage[m].outputTokens" },
        "cache_write": { "type": "integer", "minimum": 0, "description": "claude: modelUsage[m].cacheCreationInputTokens (1-hour cache in claude -p; priced with the cache_write price)" },
        "cache_read": { "type": "integer", "minimum": 0, "description": "claude: modelUsage[m].cacheReadInputTokens" },
        "sessionId": { "type": "string", "description": "claude: result.session_id (for --resume)." },
        "cliCostUsd": { "type": "number", "minimum": 0, "description": "claude: modelUsage[m].costUSD. Cross-check only, never the billing source." },
        "at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "Snapshot": {
      "type": "object",
      "description": "Git snapshot taken after a node (design.md §9: a git commit per node).",
      "additionalProperties": false,
      "required": ["commit"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "changedFiles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "DiffStat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "linesAdded", "linesRemoved"],
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "linesAdded": { "type": "integer", "minimum": 0 },
        "linesRemoved": { "type": "integer", "minimum": 0 }
      }
    },
    "Artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string", "description": "Path in the run's worktree (local only)." },
        "url": { "type": "string", "description": "Link, e.g. to a diff or a Playwright report." }
      }
    },
    "RunStartedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflowId", "release", "digest", "authorEmail", "models", "adapter"],
      "properties": {
        "workflowId": { "$ref": "#/$defs/WorkflowId" },
        "release": { "$ref": "#/$defs/ReleaseRef" },
        "releaseId": { "type": "string" },
        "digest": { "$ref": "#/$defs/Digest" },
        "authorEmail": { "$ref": "#/$defs/Email" },
        "models": { "$ref": "#/$defs/ModelAssignment" },
        "adapter": { "$ref": "#/$defs/Adapter" },
        "title": { "type": "string", "maxLength": 200, "description": "Short task title (first line of the prompt). The full prompt stays local." },
        "plannedPath": { "type": "array", "items": { "$ref": "#/$defs/NodeId" }, "description": "Nodes on the planned happy path, in order; basis for stepsPlanned and % of plan." },
        "repo": { "type": "string", "description": "Repository name (not a path)." },
        "branch": { "type": "string" },
        "runnerVersion": { "type": "string" }
      }
    },
    "InterruptPayload": {
      "type": "object",
      "description": "LangGraph interrupt waiting for the human (design.md §7).",
      "additionalProperties": false,
      "required": ["interruptId", "stage"],
      "properties": {
        "interruptId": { "type": "string", "minLength": 1 },
        "stage": { "$ref": "#/$defs/InterruptStage" },
        "message": { "type": "string", "description": "What the human is asked to decide." },
        "plan": { "type": "string", "description": "stage=plan: the plan text to approve." },
        "diffStat": { "$ref": "#/$defs/DiffStat" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$", "description": "stage=pr: tree presented for review. The first one of a run is firstResultCommit." },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/Artifact" } }
      }
    },
    "ReviewDecisionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interruptId", "stage", "decision", "approverEmail"],
      "properties": {
        "interruptId": { "type": "string", "minLength": 1 },
        "stage": { "$ref": "#/$defs/InterruptStage" },
        "decision": { "$ref": "#/$defs/ReviewDecisionValue" },
        "comment": { "type": "string", "description": "request_changes: sent back to the agent as a follow-up prompt (counted in followUpPrompts)." },
        "approverEmail": { "$ref": "#/$defs/Email", "description": "The human who decided (git config user.email). Recorded for every decision, not only approve." }
      }
    },
    "ToolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "input": { "type": "object", "additionalProperties": true, "description": "Tool input as reported by stream-json." }
      }
    },
    "AgentOutputPayload": {
      "type": "object",
      "description": "Pass-through of stream-json content for the optional live agent output (design.md §7). One event per content block. thinking blocks are normally skipped.",
      "additionalProperties": false,
      "required": ["block"],
      "properties": {
        "block": { "type": "string", "enum": ["text", "tool_use", "tool_result", "thinking"] },
        "messageId": { "type": "string" },
        "sessionId": { "type": "string" },
        "text": { "type": "string" },
        "tool": { "$ref": "#/$defs/ToolCall", "description": "block=tool_use" },
        "toolUseId": { "type": "string", "description": "block=tool_result" },
        "isError": { "type": "boolean", "description": "block=tool_result" },
        "denied": { "type": "boolean", "description": "true when the call is listed in result.permission_denials (blocked by --allowedTools)." }
      }
    },
    "GateCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "passed"],
      "properties": {
        "name": { "type": "string", "description": "e.g. pytest, property-tests, gitleaks, bandit" },
        "kind": { "type": "string", "enum": ["tests", "property_tests", "secret_scan", "security_scan", "lint", "typecheck", "other"] },
        "passed": { "type": "boolean" },
        "summary": { "type": "string" },
        "findings": { "type": "integer", "minimum": 0 }
      }
    },
    "GateResultPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "checks"],
      "properties": {
        "passed": { "type": "boolean" },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/GateCheck" } }
      }
    },
    "UsageLimitPayload": {
      "type": "object",
      "description": "From the stream-json `rate_limit_event` (docs/spikes/claude-stream-json.md §5). Emitted when status is not `allowed`.",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["allowed", "allowed_warning", "rejected"] },
        "rateLimitType": { "type": "string", "description": "e.g. five_hour; other values are passed through." },
        "resetsAt": { "$ref": "#/$defs/Timestamp", "description": "rate_limit_info.resetsAt converted from Unix seconds." },
        "paused": { "type": "boolean", "description": "true when the run is paused (RunStatus paused_usage_limit) and can be resumed after resetsAt." }
      }
    },
    "ErrorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "description": "Known codes: authentication_failed (claude not logged in), usage_limit, max_turns, agent_failed, node_failed, gate_failed, digest_mismatch, hub_unreachable, internal. Others are allowed."
        },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" }
      }
    },
    "UsageTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "cache_write", "cache_read"],
      "properties": {
        "input": { "type": "integer", "minimum": 0 },
        "output": { "type": "integer", "minimum": 0 },
        "cache_write": { "type": "integer", "minimum": 0 },
        "cache_read": { "type": "integer", "minimum": 0 },
        "cliCostUsd": { "type": "number", "minimum": 0 }
      }
    },
    "RunSummary": {
      "type": "object",
      "description": "Current state of a run. Sent by the runner in run_finished; returned by the hub (which adds costUsd, computed from the price table at read time).",
      "additionalProperties": false,
      "required": ["runId", "workflowId", "release", "digest", "status", "authorEmail", "startedAt", "models", "followUpPrompts"],
      "properties": {
        "runId": { "$ref": "#/$defs/RunId" },
        "workflowId": { "$ref": "#/$defs/WorkflowId" },
        "release": { "$ref": "#/$defs/ReleaseRef" },
        "releaseId": { "type": "string" },
        "digest": { "$ref": "#/$defs/Digest" },
        "status": { "$ref": "#/$defs/RunStatus" },
        "title": { "type": "string", "maxLength": 200 },
        "authorEmail": { "$ref": "#/$defs/Email" },
        "approverEmail": { "$ref": "#/$defs/Email" },
        "approvedAt": { "$ref": "#/$defs/Timestamp" },
        "startedAt": { "$ref": "#/$defs/Timestamp" },
        "updatedAt": { "$ref": "#/$defs/Timestamp" },
        "finishedAt": { "$ref": "#/$defs/Timestamp" },
        "models": { "$ref": "#/$defs/ModelAssignment" },
        "adapter": { "$ref": "#/$defs/Adapter" },
        "currentNode": { "$ref": "#/$defs/NodeId" },
        "progress": { "type": "number", "minimum": 0, "maximum": 100 },
        "step": { "type": "integer", "minimum": 0 },
        "stepsPlanned": { "type": "integer", "minimum": 1 },
        "firstResultCommit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$", "description": "Tree presented at the first approve_pr review; baseline of the human delta (design.md §8)." },
        "finalCommit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "followUpPrompts": { "type": "integer", "minimum": 0, "description": "Number of request_changes decisions in this run." },
        "fixLoops": { "type": "integer", "minimum": 0, "description": "Number of fix node executions (review FAIL, gate FAIL or request changes)." },
        "prUrl": { "type": "string" },
        "branch": { "type": "string" },
        "changedFiles": { "type": "array", "items": { "type": "string" } },
        "usage": { "$ref": "#/$defs/UsageTotals" },
        "costUsd": { "type": "number", "minimum": 0, "description": "Hub only: API-equivalent cost from the price table." }
      }
    },
    "RunEvent": {
      "type": "object",
      "description": "One event of a run (design.md §8). `kind` defaults to node_status, so the design example validates as-is. The payload object matching `kind` is required (see allOf). The runner sends seq (monotonic per run, from 0) on every event; the hub deduplicates on (runId, seq).",
      "additionalProperties": false,
      "required": ["runId", "at"],
      "properties": {
        "runId": { "$ref": "#/$defs/RunId" },
        "kind": { "$ref": "#/$defs/EventKind", "default": "node_status" },
        "at": { "$ref": "#/$defs/Timestamp" },
        "seq": { "type": "integer", "minimum": 0 },
        "eventId": { "type": "string" },
        "release": { "$ref": "#/$defs/ReleaseRef" },
        "digest": { "$ref": "#/$defs/Digest" },
        "node": { "$ref": "#/$defs/NodeId" },
        "attempt": { "type": "integer", "minimum": 1 },
        "status": { "$ref": "#/$defs/NodeStatus", "description": "Node status (kind=node_status)." },
        "runStatus": { "$ref": "#/$defs/RunStatus", "description": "Run status after this event, when it changed." },
        "progress": { "type": "number", "minimum": 0, "maximum": 100, "description": "% of plan (design.md §7); never moves backwards in a fix loop." },
        "step": { "type": "integer", "minimum": 0, "description": "Number of planned steps finished." },
        "stepsPlanned": { "type": "integer", "minimum": 1 },
        "model": { "type": "string", "description": "Model the node runs with, as set by the release." },
        "snapshot": { "$ref": "#/$defs/Snapshot" },
        "runStarted": { "$ref": "#/$defs/RunStartedPayload" },
        "interrupt": { "$ref": "#/$defs/InterruptPayload" },
        "reviewDecision": { "$ref": "#/$defs/ReviewDecisionPayload" },
        "agentOutput": { "$ref": "#/$defs/AgentOutputPayload" },
        "gateResult": { "$ref": "#/$defs/GateResultPayload" },
        "usage": { "$ref": "#/$defs/UsageRecord" },
        "usageLimit": { "$ref": "#/$defs/UsageLimitPayload" },
        "error": { "$ref": "#/$defs/ErrorPayload" },
        "summary": { "$ref": "#/$defs/RunSummary" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "node_status" } } }, "then": { "required": ["node", "status"] } },
        { "if": { "properties": { "kind": { "const": "run_started" } }, "required": ["kind"] }, "then": { "required": ["runStarted"] } },
        { "if": { "properties": { "kind": { "const": "interrupt" } }, "required": ["kind"] }, "then": { "required": ["interrupt", "node"] } },
        { "if": { "properties": { "kind": { "const": "review_decision" } }, "required": ["kind"] }, "then": { "required": ["reviewDecision"] } },
        { "if": { "properties": { "kind": { "const": "agent_output" } }, "required": ["kind"] }, "then": { "required": ["agentOutput", "node"] } },
        { "if": { "properties": { "kind": { "const": "gate_result" } }, "required": ["kind"] }, "then": { "required": ["gateResult", "node"] } },
        { "if": { "properties": { "kind": { "const": "usage" } }, "required": ["kind"] }, "then": { "required": ["usage"] } },
        { "if": { "properties": { "kind": { "const": "usage_limit" } }, "required": ["kind"] }, "then": { "required": ["usageLimit"] } },
        { "if": { "properties": { "kind": { "const": "error" } }, "required": ["kind"] }, "then": { "required": ["error"] } },
        { "if": { "properties": { "kind": { "const": "run_finished" } }, "required": ["kind"] }, "then": { "required": ["summary"] } }
      ]
    },
    "AuditStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "attempt", "status", "startedAt"],
      "properties": {
        "node": { "$ref": "#/$defs/NodeId" },
        "attempt": { "type": "integer", "minimum": 1 },
        "status": { "$ref": "#/$defs/NodeStatus" },
        "model": { "type": "string" },
        "startedAt": { "$ref": "#/$defs/Timestamp" },
        "finishedAt": { "$ref": "#/$defs/Timestamp" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "changedFiles": { "type": "array", "items": { "type": "string" } },
        "gate": { "$ref": "#/$defs/GateResultPayload" }
      }
    },
    "AuditDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "decision", "approverEmail", "at"],
      "properties": {
        "stage": { "$ref": "#/$defs/InterruptStage" },
        "decision": { "$ref": "#/$defs/ReviewDecisionValue" },
        "approverEmail": { "$ref": "#/$defs/Email" },
        "comment": { "type": "string" },
        "at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "AuditRecord": {
      "type": "object",
      "description": "Audit trail of one run (design.md §8 Audit): who started it, release + digest, models, steps with git snapshots, gate results, who approved and when, tokens. Written by the runner to its local audit log; the hub can rebuild it from the events.",
      "additionalProperties": false,
      "required": ["runId", "workflowId", "release", "digest", "authorEmail", "startedAt", "status", "models", "steps", "decisions", "usage"],
      "properties": {
        "runId": { "$ref": "#/$defs/RunId" },
        "workflowId": { "$ref": "#/$defs/WorkflowId" },
        "release": { "$ref": "#/$defs/ReleaseRef" },
        "digest": { "$ref": "#/$defs/Digest" },
        "status": { "$ref": "#/$defs/RunStatus" },
        "authorEmail": { "$ref": "#/$defs/Email" },
        "approverEmail": { "$ref": "#/$defs/Email" },
        "approvedAt": { "$ref": "#/$defs/Timestamp" },
        "startedAt": { "$ref": "#/$defs/Timestamp" },
        "finishedAt": { "$ref": "#/$defs/Timestamp" },
        "models": { "$ref": "#/$defs/ModelAssignment" },
        "adapter": { "$ref": "#/$defs/Adapter" },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/AuditStep" } },
        "decisions": { "type": "array", "items": { "$ref": "#/$defs/AuditDecision" } },
        "changedFiles": { "type": "array", "items": { "type": "string" } },
        "firstResultCommit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "finalCommit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "prUrl": { "type": "string" },
        "usage": { "type": "array", "items": { "$ref": "#/$defs/UsageRecord" } },
        "cliCostUsd": { "type": "number", "minimum": 0 }
      }
    },
    "HumanDelta": {
      "type": "object",
      "description": "PLANNED, not built (design.md §8 Human delta). What the human changed after the first result of a session. The hub shows sample data (sample=true) in the Planned outcomes panel.",
      "additionalProperties": false,
      "required": ["runId", "release", "digest", "outcome", "followUpPrompts", "files", "linesAdded", "linesRemoved"],
      "properties": {
        "runId": { "$ref": "#/$defs/RunId" },
        "release": { "$ref": "#/$defs/ReleaseRef" },
        "digest": { "$ref": "#/$defs/Digest" },
        "outcome": { "$ref": "#/$defs/HumanDeltaOutcome" },
        "followUpPrompts": { "type": "integer", "minimum": 0 },
        "files": { "type": "array", "items": { "type": "string" } },
        "linesAdded": { "type": "integer", "minimum": 0 },
        "linesRemoved": { "type": "integer", "minimum": 0 },
        "firstResultCommit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "mergedCommit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "diffUrl": { "type": "string", "description": "Diff in Blob, after a secret scan." },
        "source": { "type": "string", "enum": ["pr_merge_webhook", "local_push", "sample"] },
        "capturedAt": { "$ref": "#/$defs/Timestamp" },
        "sample": { "type": "boolean" }
      }
    },
    "PriceEntry": {
      "type": "object",
      "description": "Price list with validity (design.md §8). Cost = Σ tokens × price of the entry valid at the call time.",
      "additionalProperties": false,
      "required": ["model", "tokenType", "pricePerMtok", "validFrom"],
      "properties": {
        "model": { "type": "string" },
        "tokenType": { "$ref": "#/$defs/TokenType" },
        "pricePerMtok": { "type": "number", "minimum": 0, "description": "USD per million tokens (API equivalent)." },
        "validFrom": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "WorkflowManifest": {
      "type": "object",
      "description": "workflow.toml of a workflow package, parsed (design.md §5).",
      "additionalProperties": false,
      "required": ["name", "version", "entrypoint", "minRunnerVersion", "models"],
      "properties": {
        "name": { "$ref": "#/$defs/WorkflowId" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$" },
        "description": { "type": "string" },
        "entrypoint": { "type": "string", "description": "`module:function` returning the uncompiled StateGraph, e.g. graph:build_graph." },
        "minRunnerVersion": { "type": "string" },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["string", "text", "path", "boolean", "integer"] },
              "description": { "type": "string" },
              "required": { "type": "boolean" }
            }
          }
        },
        "models": { "$ref": "#/$defs/ModelAssignment" },
        "weights": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 },
          "description": "Fallback progress weight per node (design.md §7)."
        },
        "plannedPath": {
          "type": "array",
          "items": { "$ref": "#/$defs/NodeId" },
          "description": "Nodes of the happy path in order (no fix loops); the denominator of % of plan."
        },
        "interruptNodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/NodeId" },
          "description": "Nodes that call LangGraph interrupt() (human approval). get_graph() cannot see interrupt() inside a node, so the manifest declares them."
        },
        "permissions": {
          "type": "object",
          "description": "Proposal (design.md §11.2): agent permissions declared per release.",
          "additionalProperties": false,
          "properties": {
            "allowedTools": { "type": "array", "items": { "type": "string" } },
            "network": { "type": "boolean" }
          }
        }
      }
    },
    "GraphNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "description": "LangGraph node id; __start__ and __end__ for the virtual nodes." },
        "label": { "type": "string" },
        "kind": { "type": "string", "enum": ["start", "end", "step", "interrupt"] },
        "weight": { "type": "number", "minimum": 0 }
      }
    },
    "GraphEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "conditional"],
      "properties": {
        "source": { "type": "string" },
        "target": { "type": "string" },
        "conditional": { "type": "boolean" },
        "label": { "type": "string" }
      }
    },
    "GraphJSON": {
      "type": "object",
      "description": "Normalized LangGraph get_graph() output, read-only; produced by `jigworks graph` (runner) and by the hub's Sandbox validation. Rendered with React Flow.",
      "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "workflowId": { "$ref": "#/$defs/WorkflowId" },
        "release": { "$ref": "#/$defs/ReleaseRef" },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/GraphNode" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/GraphEdge" } }
      }
    },

    "HealthResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok"],
      "properties": { "ok": { "type": "boolean", "const": true } }
    },
    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "description": "e.g. unauthorized, not_found, validation_failed, conflict, digest_mismatch" },
            "message": { "type": "string" }
          }
        }
      }
    },
    "SessionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["password"],
      "properties": { "password": { "type": "string", "minLength": 1 } }
    },
    "WorkflowSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "updatedAt", "channels"],
      "properties": {
        "id": { "$ref": "#/$defs/WorkflowId" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "ownerEmail": { "$ref": "#/$defs/Email" },
        "updatedAt": { "$ref": "#/$defs/Timestamp" },
        "latestVersion": { "type": "string" },
        "channels": {
          "type": "object",
          "description": "Channel → version currently pointed to.",
          "additionalProperties": false,
          "properties": { "stable": { "type": "string" }, "beta": { "type": "string" } }
        },
        "hasUnpublishedDraft": { "type": "boolean" },
        "runs7d": { "type": "integer", "minimum": 0 },
        "source": { "type": "string", "enum": ["hub", "github"], "description": "github is shown as Planned in the MVP." }
      }
    },
    "WorkflowList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflows"],
      "properties": { "workflows": { "type": "array", "items": { "$ref": "#/$defs/WorkflowSummary" } } }
    },
    "DraftFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\./)[A-Za-z0-9_./-]+$", "description": "Relative path inside the package, e.g. graph.py, steps/plan.py, prompts/plan.md. Folders are implied by paths." },
        "content": { "type": "string" }
      }
    },
    "Draft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflowId", "files", "updatedAt"],
      "properties": {
        "workflowId": { "$ref": "#/$defs/WorkflowId" },
        "files": { "type": "array", "items": { "$ref": "#/$defs/DraftFile" } },
        "updatedAt": { "$ref": "#/$defs/Timestamp" },
        "baseReleaseId": { "type": "string", "description": "Release the draft started from." }
      }
    },
    "DraftUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files"],
      "properties": {
        "files": { "type": "array", "items": { "$ref": "#/$defs/DraftFile" }, "description": "Full replacement of the draft's files." }
      }
    },
    "ValidationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ok"],
      "properties": {
        "name": { "type": "string", "enum": ["manifest", "syntax", "imports", "compile", "graph"] },
        "ok": { "type": "boolean" },
        "message": { "type": "string" },
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 }
      }
    },
    "ValidationResult": {
      "type": "object",
      "description": "Result of validating the draft in isolation (Vercel Sandbox). graph is present when compile succeeded; the editor's Graph toggle renders it.",
      "additionalProperties": false,
      "required": ["ok", "checks"],
      "properties": {
        "ok": { "type": "boolean" },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/ValidationCheck" } },
        "graph": { "$ref": "#/$defs/GraphJSON" },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "PublishRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$" },
        "notes": { "type": "string" },
        "channel": { "$ref": "#/$defs/ChannelName", "description": "Point this channel to the new release." }
      }
    },
    "Release": {
      "type": "object",
      "description": "Immutable published release (design.md §6).",
      "additionalProperties": false,
      "required": ["id", "workflowId", "version", "digest", "publishedAt"],
      "properties": {
        "id": { "type": "string" },
        "workflowId": { "$ref": "#/$defs/WorkflowId" },
        "version": { "type": "string" },
        "release": { "$ref": "#/$defs/ReleaseRef" },
        "digest": { "$ref": "#/$defs/Digest" },
        "publishedAt": { "$ref": "#/$defs/Timestamp" },
        "publishedBy": { "$ref": "#/$defs/Email" },
        "notes": { "type": "string" },
        "manifest": { "$ref": "#/$defs/WorkflowManifest" },
        "bundleBytes": { "type": "integer", "minimum": 0 },
        "channels": { "type": "array", "items": { "$ref": "#/$defs/ChannelName" } }
      }
    },
    "ReleaseList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releases"],
      "properties": { "releases": { "type": "array", "items": { "$ref": "#/$defs/Release" } } }
    },
    "ChannelResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflowId", "channel", "releaseId", "version", "digest"],
      "properties": {
        "workflowId": { "$ref": "#/$defs/WorkflowId" },
        "channel": { "$ref": "#/$defs/ChannelName" },
        "releaseId": { "type": "string" },
        "version": { "type": "string" },
        "digest": { "$ref": "#/$defs/Digest" },
        "bundleUrl": { "type": "string", "description": "Relative URL of the bundle, e.g. /api/releases/{id}/bundle." }
      }
    },
    "ChannelUpdate": {
      "type": "object",
      "description": "Point a channel to a release (publish or rollback).",
      "additionalProperties": false,
      "required": ["releaseId"],
      "properties": { "releaseId": { "type": "string" } }
    },
    "RunCreate": {
      "type": "object",
      "description": "Register a run and its pinned release. Idempotent on runId.",
      "additionalProperties": false,
      "required": ["runId", "workflowId", "release", "digest", "authorEmail", "models", "startedAt"],
      "properties": {
        "runId": { "$ref": "#/$defs/RunId" },
        "workflowId": { "$ref": "#/$defs/WorkflowId" },
        "releaseId": { "type": "string" },
        "release": { "$ref": "#/$defs/ReleaseRef" },
        "digest": { "$ref": "#/$defs/Digest" },
        "authorEmail": { "$ref": "#/$defs/Email" },
        "models": { "$ref": "#/$defs/ModelAssignment" },
        "adapter": { "$ref": "#/$defs/Adapter" },
        "title": { "type": "string", "maxLength": 200 },
        "stepsPlanned": { "type": "integer", "minimum": 1 },
        "startedAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "RunList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runs"],
      "properties": {
        "runs": { "type": "array", "items": { "$ref": "#/$defs/RunSummary" } },
        "nextCursor": { "type": "string" }
      }
    },
    "RunDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": { "$ref": "#/$defs/RunSummary" },
        "audit": { "$ref": "#/$defs/AuditRecord" },
        "graph": { "$ref": "#/$defs/GraphJSON" }
      }
    },
    "EventBatch": {
      "type": "object",
      "description": "Ingest batch. Every event must carry runId equal to the path id and a seq; the hub stores each (runId, seq) once and counts re-sent ones as duplicates (offline queue replay is safe).",
      "additionalProperties": false,
      "required": ["events"],
      "properties": {
        "events": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/RunEvent" } }
      }
    },
    "EventBatchResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "duplicates"],
      "properties": {
        "accepted": { "type": "integer", "minimum": 0 },
        "duplicates": { "type": "integer", "minimum": 0 },
        "lastSeq": { "type": "integer", "minimum": 0 }
      }
    },
    "EventPage": {
      "type": "object",
      "description": "Polling fallback for the SSE stream: events with seq > after.",
      "additionalProperties": false,
      "required": ["events"],
      "properties": {
        "events": { "type": "array", "items": { "$ref": "#/$defs/RunEvent" } },
        "lastSeq": { "type": "integer", "minimum": 0 }
      }
    },
    "UsageReportRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "runs", "input", "output", "cache_write", "cache_read", "costUsd"],
      "properties": {
        "key": { "type": "string", "description": "Value of the groupBy dimension (release, model, node or day)." },
        "runs": { "type": "integer", "minimum": 0 },
        "input": { "type": "integer", "minimum": 0 },
        "output": { "type": "integer", "minimum": 0 },
        "cache_write": { "type": "integer", "minimum": 0 },
        "cache_read": { "type": "integer", "minimum": 0 },
        "costUsd": { "type": "number", "minimum": 0 },
        "cliCostUsd": { "type": "number", "minimum": 0 }
      }
    },
    "UsageReport": {
      "type": "object",
      "description": "Cost is labelled API equivalent: on a subscription nobody pays per token (design.md §8).",
      "additionalProperties": false,
      "required": ["groupBy", "costLabel", "rows", "totals", "prices"],
      "properties": {
        "groupBy": { "type": "string", "enum": ["release", "model", "node", "day"] },
        "workflowId": { "$ref": "#/$defs/WorkflowId" },
        "from": { "$ref": "#/$defs/Timestamp" },
        "to": { "$ref": "#/$defs/Timestamp" },
        "costLabel": { "type": "string", "const": "API equivalent" },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/UsageReportRow" } },
        "totals": { "$ref": "#/$defs/UsageReportRow" },
        "prices": { "type": "array", "items": { "$ref": "#/$defs/PriceEntry" } }
      }
    },
    "ReleaseComparisonRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "version", "runs", "succeeded", "failed", "rejected", "avgFixLoops", "avgCostUsd"],
      "properties": {
        "release": { "$ref": "#/$defs/ReleaseRef" },
        "version": { "type": "string" },
        "runs": { "type": "integer", "minimum": 0 },
        "succeeded": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "successRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "avgFixLoops": { "type": "number", "minimum": 0 },
        "avgFollowUpPrompts": { "type": "number", "minimum": 0 },
        "avgCostUsd": { "type": "number", "minimum": 0 },
        "avgDurationSec": { "type": "number", "minimum": 0 }
      }
    },
    "ReleaseComparison": {
      "type": "object",
      "description": "Version comparison (design.md §11.3).",
      "additionalProperties": false,
      "required": ["workflowId", "rows"],
      "properties": {
        "workflowId": { "$ref": "#/$defs/WorkflowId" },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/ReleaseComparisonRow" } }
      }
    },
    "OutcomeReport": {
      "type": "object",
      "description": "PLANNED human-delta outcomes. The hub returns sample data (sample=true) and the UI labels the panel Planned.",
      "additionalProperties": false,
      "required": ["planned", "sample", "rows"],
      "properties": {
        "planned": { "type": "boolean", "const": true },
        "sample": { "type": "boolean" },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["release", "outcome", "sessions"],
            "properties": {
              "release": { "$ref": "#/$defs/ReleaseRef" },
              "outcome": { "$ref": "#/$defs/HumanDeltaOutcome" },
              "sessions": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "deltas": { "type": "array", "items": { "$ref": "#/$defs/HumanDelta" } }
      }
    }
  }
}
